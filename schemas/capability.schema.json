{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yugatn/MyPro/schemas/capability.schema.json",
  "title": "MyPro Capability v0.3",
  "type": "object",
  "required": ["id", "subject", "operations", "resource_scope", "issued_at", "expires_at", "revocable", "delegable"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "operations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "resource_scope": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string"},
    "expires_at": {"type": "string"},
    "revocable": {"type": "boolean"},
    "delegable": {"type": "boolean"},
    "parent": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
