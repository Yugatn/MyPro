{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://mypro.local/schemas/event-envelope.v0.1.schema.json",
  "title":"MyPro Agent Event Envelope v0.1",
  "type":"object","additionalProperties":false,
  "required":["event_id","event_type","task_id","issuer","correlation_id","idempotency_key","payload","evidence_refs","schema_version"],
  "properties":{
    "event_id":{"type":"string","minLength":1},"event_type":{"type":"string","minLength":1},
    "task_id":{"type":"string","minLength":1},"issuer":{"type":"string","minLength":1},
    "correlation_id":{"type":"string","minLength":1},"idempotency_key":{"type":"string","minLength":1},
    "payload":{"type":"object"},"evidence_refs":{"type":"array","items":{"type":"object"}},"schema_version":{"const":"0.1"}
  }
}
